# Only public values here. Never put GROQ_API_KEY or any secret in the web app.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Error tracking in the web app (optional). The same DSN can be used for the API. Empty = off.
# SENTRY_DSN=
# SENTRY_RELEASE=
# Only if you use Sentry: the host of your DSN, allowed by the Content-Security-Policy (build time).
# SENTRY_INGEST_ORIGIN=https://o000000.ingest.sentry.io
