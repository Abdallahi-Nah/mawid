DATABASE_URL=postgresql://mawid:mawid@localhost:5434/mawid
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-chars-long
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
GROQ_API_KEY=
GROQ_MODEL_CHAT=
GROQ_MODEL_FAST=
GROQ_MODEL_STT=
# Empty models use the defaults: llama-3.3-70b-versatile (chat), llama-3.1-8b-instant (fast), whisper-large-v3-turbo (voice)
# AI_ENABLED=true            # false = kill switch
# AI_TIMEOUT_MS=15000
# AI_MONTHLY_QUOTA=1000      # Groq calls per month for a FREE business
RESEND_API_KEY=
MAIL_FROM=Mawid <no-reply@example.com>
# Optional: queue name prefix (keeps environments apart in one Redis) and retry delay of failed emails
# QUEUE_PREFIX=mawid
# NOTIFY_BACKOFF_MS=30000

# Swagger page (/docs) is off in production unless this is true
# API_DOCS=false

# Error tracking (optional): empty = Sentry is off. LOG_LEVEL: fatal, error, warn, info (default in production), debug
# SENTRY_DSN=
# SENTRY_RELEASE=
# LOG_LEVEL=info

# Reverse proxies in front of the API (1 on Railway, Render or behind Caddy/nginx; 0 when exposed directly)
# TRUST_PROXY=1

# Only for a test deployment without a domain (docs/DEPLOY.md, "No domain"): path under which the web app relays the API
# COOKIE_PATH_PREFIX=/backend
