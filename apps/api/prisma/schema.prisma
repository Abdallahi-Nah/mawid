generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Foundation model. Every business table will carry business_id (see CLAUDE.md).
model Business {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("businesses")
}
